## Docker compose settings for local deployment

##### Gateway (Envoy) #####
# Envoy configuration file path
ENVOY_FILE=./envoy/envoy.yaml
# The port Envoy proxy exposes on the host machine
PROXY_EXPOSE_PORT=80
# Directory for SSL certificates (uncomment and set if using SSL)
#CERTS_DIR=/home/hanaeco/cert/etc/letsencrypt
# Directory for SSL certificate archives (uncomment and set if using SSL)
# CERTS_ARCHIVE_DIR=/home/hanaeco/cert/etc/letsencrypt/archive/hanaeco.dev

# Auth0 issuer URL for authentication. :CHANGE-ME if needed.
# No need to set if Auth0 IDP is not used.
AUTH0_ISSUER_URL=

##### hanaeco-web #####
# Node environment for web app (development allows non-https)
WEB_NODE_ENV=development
# Docker image for hanaeco-web
HANAECO_WEB_IMAGE=hanalooper/hanaeco-web:1.8.4
# Port exposed by hanaeco-web container
HANAECO_WEB_EXPOSE_PORT=3080

# Base URL for backend API (hanaeco-server-onprem)
BAPI_BASE_URL=http://hanaeco-server-onprem:3000

##### hanaeco-server #####
# Node environment for server app
SERVER_NODE_ENV=development
# Docker image for hanaeco-server
HANAECO_SERVER_IMAGE=hanalooper/hanaeco-server:1.8.4
# Port exposed by hanaeco-server container
HANAECO_SERVER_EXPOSE_PORT=9080

# CHANGE_ME: The full path for the database storage directory
# In Windows use this format: //c/Users/Public/hanaeco/dbdata
# /your/path/hanaeco-onprem-location/database
# in Windows: //c/Users/(user)/hanaeco/dbdata
DBDATA_LOCATION_ROOT=/absolute_path_to/hanaeco/database

# CHANGE_ME: The full path for uploaded file storage
# /your/path/hanaeco-onprem-location/files
# in Windows: //c/Users/(user)/hanaeco/uploadfiles
STORAGE_LOCATION_ROOT=/absolute_path_to/hanaeco/files

# CHANGE_ME: The full path for the connectors seed data directory
# /your/path/hanaeco-onprem-location/seed-data-connectors :CHANGE_ME
SEED_DATA_CONNECTORS_LOCATION=/absolute_path_to/hanaeco/hanaeco-onprem-template/seed-data-connectors


# The following AUTH0_* envs are not needed to set if Auth0 IDP is not used.
# Auth0 audience for API access :CHANGE_ME if needed
AUTH0_AUDIENCE=

# Auth0 domain for authentication :CHANGE_ME if needed
AUTH0_DOMAIN=
# Auth0 secret for server-side validation :CHANGE_ME if needed
AUTH0_SECRET=
# Auth0 client ID for server :CHANGE_ME if needed
AUTH0_CLIENT_ID=
# Auth0 client secret for server :CHANGE_ME if needed
AUTH0_CLIENT_SECRET=

# Database username
DB_USERNAME=hanaeco
# Database password
#DB_PASSWORD=CHANGE_ME-DB_PASSWORD
# Database name
DB_DATABASE_NAME=hanaeco_onprem

##### hanaeco-ml #####
# Docker image for hanaeco-ml
HANAECO_ML_IMAGE=hanalooper/hanaeco-ml:0.9.7
# Port exposed by hanaeco-ml container
HANAECO_ML_EXPOSE_PORT=9980

# Secret for NextAuth authentication
NEXTAUTH_SECRET=CHANGE_ME-NEXTAUTH_SECRET
