# ================================
# Environment for Hanaeco web application
# ================================

# Backend API base URL. 
# Use the service hostname within the Docker network (not localhost).
BAPI_BASE_URL=http://ecoloop-server-onprem:3000

# Public base URL of the web application (used in redirects, links, etc.)
# Typically "http://localhost" for local dev, or your domain in production.
WEB_BASE_URL=http://localhost

# External URL used by NextAuth for authentication redirects.
# If using a custom domain, set it here (e.g., https://www.hanademo.eco).
NEXTAUTH_URL=http://localhost

# Internal URL for NextAuth.
# Used when the server cannot access the public/canonical URL directly.
# In most cases, this env will not require change.
NEXTAUTH_URL_INTERNAL=http://ecoloop-web-onprem

# Whether to mark cookies as "secure".
# Set to "false" if:
#   - you access the app remotely (not localhost), AND
#   - your server does not have an SSL certificate installed.
# COOKIE_OPT_SECURE=false